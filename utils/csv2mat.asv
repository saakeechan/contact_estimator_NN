clear;
clc;
close all;

T = readtable('/home/saakee/Research/deep-contact-estimator/Data/CSVFiles/robotstate_0_env0.csv');

contacts = [T.lfoot_contact, T.rfoot_contact];
gait_cycle_contacts = [T.lfoot_contact_plan, T.rfoot_contact_plan];

control_time = T.timestamp;
imu_time = T.timestamp;   % same source in your file

imu_acc   = [T.acc_x, T.acc_y, T.acc_z];
imu_omega = [T.omega_x, T.omega_y, T.omega_z];

p = [T.fk_left_foot_pos_x T.fk_left_foot_pos_y T.fk_left_foot_pos_z ...
    T.fk_right_foot_pos_x T.fk_right_foot_pos_y T.fk_right_foot_pos_z];

v = same thing but vel_x for FK


%Extra
imu_quat  = [T.quat_w, T.quat_i, T.quat_j, T.quat_k];
imu_rpy   = [T.roll, T.pitch, T.yaw];

F = [ ...
    T.rfoot_grf_x, T.rfoot_grf_y, T.rfoot_grf_z, ...
    T.lfoot_grf_x, T.lfoot_grf_y, T.lfoot_grf_z];

F_contacts = [ ...
    T.rfoot_grt_x, T.rfoot_grt_y, T.rfoot_grt_z, ...
    T.lfoot_grt_x, T.lfoot_grt_y, T.lfoot_grt_z];




